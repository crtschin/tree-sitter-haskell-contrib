lang := "ghc_cmm"
slug := "ghc-cmm"

# pipefail passes a gate script's exit status through `| tapview`.
set shell := ["bash", "-o", "pipefail", "-c"]

import 'common/recipes.just'

default: test

# Run every gate.
test: _il-test

# Parse every harvested Cmm dump in $GHC_SRC.
parse-corpus:
    ../test/runners/parse-corpus.sh {{ slug }} | tapview

# Generate Cmm dumps with GHC in a temp dir and parse them.
gen-corpus: build
    ../test/runners/gen-corpus.sh {{ slug }} | tapview
