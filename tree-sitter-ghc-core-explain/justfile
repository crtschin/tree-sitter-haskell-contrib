lang := "ghc_core_explain"
slug := "ghc-core-explain"

# Run recipe lines under bash with pipefail so a gate script's non-zero exit
# propagates through `| tapview` (the script, not tapview, decides pass/fail).
set shell := ["bash", "-o", "pipefail", "-c"]

import 'common/recipes.just'

default: test

# Full gate suite: queries, committed samples, generated matrix, inline tests.
test: _il-test

# Parse the committed sample dumps in test/samples. These logs have no phase
# banner, so no harvest from $GHC_SRC can find them.
parse-corpus:
    ../test/runners/parse-corpus.sh {{ slug }} | tapview

# Generate rule-firings and inlinings dumps with GHC, with and without
# -dppr-debug, into a temporary directory and parse them.
gen-corpus: build
    ../test/runners/gen-corpus.sh {{ slug }} | tapview
