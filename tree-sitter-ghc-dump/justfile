lang := "ghc_dump"
slug := "ghc-dump"

# pipefail lets the exit code of a gate script pass through `| tapview`.
set shell := ["bash", "-o", "pipefail", "-c"]

import 'common/recipes.just'

default: test

# Run the IL gate suite plus the injection dispatch gate.
test: (_il-test "validate-injections")

# Parse every harvested dump stream in $GHC_SRC. This checks only the split
# into banner and body.
parse-corpus:
    ../test/runners/parse-corpus.sh {{ slug }} | tapview

# Parse each harvested section with the member grammar that injections.scm
# picks. Builds the member parsers first.
validate-injections:
    nix build ..#tree-sitter-ghc-core -o ../tree-sitter-ghc-core/result
    nix build ..#tree-sitter-ghc-stg -o ../tree-sitter-ghc-stg/result
    nix build ..#tree-sitter-ghc-cmm -o ../tree-sitter-ghc-cmm/result
    ../test/runners/validate-injections.sh | tapview

# Generate a multi-IL stream with GHC in a temp dir and parse it.
gen-corpus: build
    ../test/runners/gen-corpus.sh {{ slug }} | tapview
