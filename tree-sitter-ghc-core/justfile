lang := "ghc_core"
slug := "ghc-core"

# Run recipe lines under bash with pipefail so a gate script's non-zero exit
# propagates through `| tapview` (the script, not tapview, decides pass/fail).
set shell := ["bash", "-o", "pipefail", "-c"]

import 'common/recipes.just'

default: test

# Run the full gate suite: queries, harvested corpus, generated matrix, inline tests.
test: _il-test

# Parse every harvested single-pass Tidy Core .stderr in $GHC_SRC.
parse-corpus:
    ../test/runners/parse-corpus.sh {{ slug }} | tapview

# Compile the dump-flag matrix with GHC and parse it as a TAP suite (needs GHC).
gen-corpus: build
    ../test/runners/gen-corpus.sh {{ slug }} | tapview
